# Names only. Never commit values. Unset adapters run against in-memory fakes.

PORT=8787
# On Azure App Service: /home/data (set by scripts/deploy-azure.sh).
JARVIS_DATA_DIR=./data

# Board sign-in for the owner (STOP ALL, approvals). Required outside localhost.
JARVIS_BOARD_TOKEN=

# One static token per Studio agent, registered with the Jarvis MCP server in Studio.
# Format: agentName:token,agentName:token
# Agents: project-manager, builder (shared by every builder instance), verifier, curator, planner, designer.
JARVIS_AGENT_TOKENS=

# Azure App Service only (set by scripts/deploy-azure.sh).
SCM_DO_BUILD_DURING_DEPLOYMENT=

# Trimble Agent Studio (Agents API). Token: STUDIO_TOKEN, or a TID app's client credentials.
STUDIO_API_BASE=
STUDIO_API_KEY=
STUDIO_TOKEN=
TID_CLIENT_ID=
TID_CLIENT_SECRET=
TID_TOKEN_URL=https://stage.id.trimblecloud.com/oauth/token
STUDIO_PM_AGENT_ID=

# Azure Boards: work-items-only PAT, and the shared secret on the service hook.
AZDO_ORG_URL=
AZDO_PROJECT=
JARVIS_PROJECT=jarvis
AZDO_PAT=
AZDO_HOOK_USER=
AZDO_HOOK_PASSWORD=

# GitHub: fine-grained token for the one repo (or GitHub App), and the webhook secret.
GITHUB_REPO=salvador-ram-trimble/jarvis_project
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# AgentBrake: path to the agentbrake CLI (Python 3.10+). Unset = in-memory fake brake.
AGENTBRAKE_BIN=
AGENTBRAKE_HOME=
